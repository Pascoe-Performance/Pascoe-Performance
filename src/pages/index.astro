---
import '../styles/global.css';
import '../styles/pages/home.css';
import '../styles/enhancements.css';
import Base from '../layouts/Base.astro';
import InquiryForm from '../components/InquiryForm.astro';
import FaqList from '../components/FaqList.astro';
import faqs from '../data/faqs.json';
---
<Base page="home" hasForm={true}>
<section class="hero" id="top" aria-labelledby="hero-title">
<div class="tech-grid" aria-hidden="true"></div>
<div class="glow" aria-hidden="true"></div>
<svg class="hero-mark" viewBox="252 322 378 458" aria-hidden="true"><path class="draw" pathLength="1" d="M277.5 347.5H445C540 347.5 604.5 405 604.5 495C604.5 585 540 641.5 440 641.5H387.5V755.5H277.5V540H440C475 540 492.5 520 492.5 495C492.5 470 475 449.5 440 449.5H387.5V495.5H277.5Z"></path><rect class="draw" pathLength="1" x="430.5" y="684.5" width="162" height="71"></rect></svg>
<div class="wrap hero-grid">
<div>
<p class="eyebrow in d1">Personal Training &amp; Football Performance Training · Hamilton, Ontario</p>
<h1 id="hero-title" class="display hero-title">
<span class="in d1 solid">Train Stronger.</span>
<span class="in d2 accent">Move Faster.</span>
<span class="in d3 solid">Perform Better.</span>
</h1>
<p class="lede in d4">Personal training and football performance coaching with Ben Pascoe, supported by practical nutrition guidance.</p>
<div class="hero-paths in d5">
<a class="btn btn-glass btn-path" href="/personal-training/"><span>Personal Training</span><span class="arrow" aria-hidden="true">→</span></a>
<a class="btn btn-glass btn-path" href="/football-performance/"><span>Football Performance</span><span class="arrow" aria-hidden="true">→</span></a>
</div>
<ul class="trust-line in d5" aria-label="Coach credentials">
<li>NSCA-certified (CSCS)</li><li>10+ years coaching</li><li>100+ OUA varsity athletes</li><li>Former All-Canadian linebacker</li>
</ul>
</div>
<div class="hero-media glass in d3">
<span class="hud tl" aria-hidden="true"></span><span class="hud br" aria-hidden="true"></span>
<div class="scan" aria-hidden="true"></div>
<div class="hero-video-wrap">
<video class="hero-video" autoplay="autoplay" muted="muted" loop="loop" playsinline="playsinline" preload="metadata" poster="/media/hero-poster.jpg" aria-label="Ben Pascoe coaching: spotting a bench press and working with a football athlete on the turf">
<source src="/media/hero.webm" type="video/webm">
<source src="/media/hero.mp4" type="video/mp4">
</video>
<button class="video-toggle" type="button" aria-label="Pause video" data-video-toggle><svg class="icon-play" width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M8 5v14l11-7z"></path></svg><svg class="icon-pause" width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M7 5h4v14H7zM13 5h4v14h-4z"></path></svg></button>
</div>
<span class="media-bar" aria-hidden="true"></span>
</div>
</div>
</section>

<div class="ticker" aria-hidden="true">
<div class="ticker-track"><p class="ticker-item">Personal Training<span></span>Football Performance<span></span>Strength<span></span>Speed<span></span>Conditioning<span></span>Movement<span></span>Nutrition<span></span>Hamilton &amp; Ancaster<span></span>Greater Toronto &amp; Hamilton Area<span></span></p><p class="ticker-item">Personal Training<span></span>Football Performance<span></span>Strength<span></span>Speed<span></span>Conditioning<span></span>Movement<span></span>Nutrition<span></span>Hamilton &amp; Ancaster<span></span>Greater Toronto &amp; Hamilton Area<span></span></p></div>
</div>

<section class="section section--after-ticker" id="paths" aria-labelledby="paths-title">
<div class="wrap">
<div class="section-head section-head--stack">
<div class="reveal">
<p class="kicker">Choose your path</p>
<h2 id="paths-title" class="display h2">Strength for every day.<br>Performance for game day.</h2>
</div>
<p class="reveal r2">Two ways to train with Ben. Choose the one that matches your goals.</p>
</div>
<div class="paths">
<article class="path-card glass reveal" id="personal-training">
<span class="edge" aria-hidden="true"></span>
<div class="path-media">
<span class="path-num">01 · Personal</span>
<div class="card-fit"><span class="card-fit-bg" aria-hidden="true"></span><video class="pt-video card-fit-video" autoplay="autoplay" muted="muted" loop="loop" playsinline="playsinline" preload="metadata" poster="/media/personal-training-poster.jpg" aria-label="Ben Pascoe coaching a medicine ball drill and talking with a personal training client"><source src="/media/personal-training.webm" type="video/webm"><source src="/media/personal-training.mp4" type="video/mp4"></video></div>
</div>
<div class="path-body">
<h3 class="display">Personal Training</h3>
<p>Build strength, improve conditioning and feel more confident in the gym. Train with Ben at Anytime Fitness in Hamilton and Ancaster, with coaching adapted to your experience and goals.</p>
<ul class="chips"><li>Strength</li><li>Conditioning</li><li>Mobility</li><li>Body composition</li><li>Confidence</li></ul>
<a class="path-link" href="/personal-training/">Explore Personal Training <span class="arrow" aria-hidden="true">→</span></a>
</div>
</article>
<div class="fp-wrap">
<div class="fp-bg" aria-hidden="true"><svg viewBox="0 0 1000 1600" preserveAspectRatio="xMidYMid slice" focusable="false"><rect x="0" y="0" width="1000" height="200" fill="#2F9A5E" opacity=".32"></rect><rect x="0" y="200" width="1000" height="200" fill="#2F9A5E" opacity=".6"></rect><rect x="0" y="400" width="1000" height="200" fill="#2F9A5E" opacity=".32"></rect><rect x="0" y="600" width="1000" height="200" fill="#2F9A5E" opacity=".6"></rect><rect x="0" y="800" width="1000" height="200" fill="#2F9A5E" opacity=".32"></rect><rect x="0" y="1000" width="1000" height="200" fill="#2F9A5E" opacity=".6"></rect><rect x="0" y="1200" width="1000" height="200" fill="#2F9A5E" opacity=".32"></rect><rect x="0" y="1400" width="1000" height="200" fill="#2F9A5E" opacity=".6"></rect><line x1="0" y1="0" x2="1000" y2="0" stroke="#FFFFFF" stroke-width="7"></line><line x1="0" y1="200" x2="1000" y2="200" stroke="#FFFFFF" stroke-width="7"></line><line x1="0" y1="400" x2="1000" y2="400" stroke="#FFFFFF" stroke-width="7"></line><line x1="0" y1="600" x2="1000" y2="600" stroke="#FFFFFF" stroke-width="7"></line><line x1="0" y1="800" x2="1000" y2="800" stroke="#FFFFFF" stroke-width="7"></line><line x1="0" y1="1000" x2="1000" y2="1000" stroke="#FFFFFF" stroke-width="7"></line><line x1="0" y1="1200" x2="1000" y2="1200" stroke="#FFFFFF" stroke-width="7"></line><line x1="0" y1="1400" x2="1000" y2="1400" stroke="#FFFFFF" stroke-width="7"></line><line x1="0" y1="1600" x2="1000" y2="1600" stroke="#FFFFFF" stroke-width="7"></line><line x1="306" y1="40" x2="354" y2="40" stroke="#FFFFFF" stroke-width="5"></line><line x1="646" y1="40" x2="694" y2="40" stroke="#FFFFFF" stroke-width="5"></line><line x1="306" y1="80" x2="354" y2="80" stroke="#FFFFFF" stroke-width="5"></line><line x1="646" y1="80" x2="694" y2="80" stroke="#FFFFFF" stroke-width="5"></line><line x1="306" y1="120" x2="354" y2="120" stroke="#FFFFFF" stroke-width="5"></line><line x1="646" y1="120" x2="694" y2="120" stroke="#FFFFFF" stroke-width="5"></line><line x1="306" y1="160" x2="354" y2="160" stroke="#FFFFFF" stroke-width="5"></line><line x1="646" y1="160" x2="694" y2="160" stroke="#FFFFFF" stroke-width="5"></line><line x1="306" y1="240" x2="354" y2="240" stroke="#FFFFFF" stroke-width="5"></line><line x1="646" y1="240" x2="694" y2="240" stroke="#FFFFFF" stroke-width="5"></line><line x1="306" y1="280" x2="354" y2="280" stroke="#FFFFFF" stroke-width="5"></line><line x1="646" y1="280" x2="694" y2="280" stroke="#FFFFFF" stroke-width="5"></line><line x1="306" y1="320" x2="354" y2="320" stroke="#FFFFFF" stroke-width="5"></line><line x1="646" y1="320" x2="694" y2="320" stroke="#FFFFFF" stroke-width="5"></line><line x1="306" y1="360" x2="354" y2="360" stroke="#FFFFFF" stroke-width="5"></line><line x1="646" y1="360" x2="694" y2="360" stroke="#FFFFFF" stroke-width="5"></line><line x1="306" y1="440" x2="354" y2="440" stroke="#FFFFFF" stroke-width="5"></line><line x1="646" y1="440" x2="694" y2="440" stroke="#FFFFFF" stroke-width="5"></line><line x1="306" y1="480" x2="354" y2="480" stroke="#FFFFFF" stroke-width="5"></line><line x1="646" y1="480" x2="694" y2="480" stroke="#FFFFFF" stroke-width="5"></line><line x1="306" y1="520" x2="354" y2="520" stroke="#FFFFFF" stroke-width="5"></line><line x1="646" y1="520" x2="694" y2="520" stroke="#FFFFFF" stroke-width="5"></line><line x1="306" y1="560" x2="354" y2="560" stroke="#FFFFFF" stroke-width="5"></line><line x1="646" y1="560" x2="694" y2="560" stroke="#FFFFFF" stroke-width="5"></line><line x1="306" y1="640" x2="354" y2="640" stroke="#FFFFFF" stroke-width="5"></line><line x1="646" y1="640" x2="694" y2="640" stroke="#FFFFFF" stroke-width="5"></line><line x1="306" y1="680" x2="354" y2="680" stroke="#FFFFFF" stroke-width="5"></line><line x1="646" y1="680" x2="694" y2="680" stroke="#FFFFFF" stroke-width="5"></line><line x1="306" y1="720" x2="354" y2="720" stroke="#FFFFFF" stroke-width="5"></line><line x1="646" y1="720" x2="694" y2="720" stroke="#FFFFFF" stroke-width="5"></line><line x1="306" y1="760" x2="354" y2="760" stroke="#FFFFFF" stroke-width="5"></line><line x1="646" y1="760" x2="694" y2="760" stroke="#FFFFFF" stroke-width="5"></line><line x1="306" y1="840" x2="354" y2="840" stroke="#FFFFFF" stroke-width="5"></line><line x1="646" y1="840" x2="694" y2="840" stroke="#FFFFFF" stroke-width="5"></line><line x1="306" y1="880" x2="354" y2="880" stroke="#FFFFFF" stroke-width="5"></line><line x1="646" y1="880" x2="694" y2="880" stroke="#FFFFFF" stroke-width="5"></line><line x1="306" y1="920" x2="354" y2="920" stroke="#FFFFFF" stroke-width="5"></line><line x1="646" y1="920" x2="694" y2="920" stroke="#FFFFFF" stroke-width="5"></line><line x1="306" y1="960" x2="354" y2="960" stroke="#FFFFFF" stroke-width="5"></line><line x1="646" y1="960" x2="694" y2="960" stroke="#FFFFFF" stroke-width="5"></line><line x1="306" y1="1040" x2="354" y2="1040" stroke="#FFFFFF" stroke-width="5"></line><line x1="646" y1="1040" x2="694" y2="1040" stroke="#FFFFFF" stroke-width="5"></line><line x1="306" y1="1080" x2="354" y2="1080" stroke="#FFFFFF" stroke-width="5"></line><line x1="646" y1="1080" x2="694" y2="1080" stroke="#FFFFFF" stroke-width="5"></line><line x1="306" y1="1120" x2="354" y2="1120" stroke="#FFFFFF" stroke-width="5"></line><line x1="646" y1="1120" x2="694" y2="1120" stroke="#FFFFFF" stroke-width="5"></line><line x1="306" y1="1160" x2="354" y2="1160" stroke="#FFFFFF" stroke-width="5"></line><line x1="646" y1="1160" x2="694" y2="1160" stroke="#FFFFFF" stroke-width="5"></line><line x1="306" y1="1240" x2="354" y2="1240" stroke="#FFFFFF" stroke-width="5"></line><line x1="646" y1="1240" x2="694" y2="1240" stroke="#FFFFFF" stroke-width="5"></line><line x1="306" y1="1280" x2="354" y2="1280" stroke="#FFFFFF" stroke-width="5"></line><line x1="646" y1="1280" x2="694" y2="1280" stroke="#FFFFFF" stroke-width="5"></line><line x1="306" y1="1320" x2="354" y2="1320" stroke="#FFFFFF" stroke-width="5"></line><line x1="646" y1="1320" x2="694" y2="1320" stroke="#FFFFFF" stroke-width="5"></line><line x1="306" y1="1360" x2="354" y2="1360" stroke="#FFFFFF" stroke-width="5"></line><line x1="646" y1="1360" x2="694" y2="1360" stroke="#FFFFFF" stroke-width="5"></line><line x1="306" y1="1440" x2="354" y2="1440" stroke="#FFFFFF" stroke-width="5"></line><line x1="646" y1="1440" x2="694" y2="1440" stroke="#FFFFFF" stroke-width="5"></line><line x1="306" y1="1480" x2="354" y2="1480" stroke="#FFFFFF" stroke-width="5"></line><line x1="646" y1="1480" x2="694" y2="1480" stroke="#FFFFFF" stroke-width="5"></line><line x1="306" y1="1520" x2="354" y2="1520" stroke="#FFFFFF" stroke-width="5"></line><line x1="646" y1="1520" x2="694" y2="1520" stroke="#FFFFFF" stroke-width="5"></line><line x1="306" y1="1560" x2="354" y2="1560" stroke="#FFFFFF" stroke-width="5"></line><line x1="646" y1="1560" x2="694" y2="1560" stroke="#FFFFFF" stroke-width="5"></line></svg></div>
<article class="path-card glass reveal r2" id="football-performance">
<span class="edge" aria-hidden="true"></span>
<div class="path-media">
<span class="path-num">02 · Football</span>
<video class="fb-video card-video" autoplay="autoplay" muted="muted" loop="loop" playsinline="playsinline" preload="metadata" poster="/media/football-performance-poster.jpg" aria-label="Ben Pascoe coaching football athletes through drills on indoor turf"><source src="/media/football-performance.webm" type="video/webm"><source src="/media/football-performance.mp4" type="video/mp4"></video>
</div>
<div class="path-body">
<h3 class="display">Football Performance</h3>
<p>Develop the speed, strength and movement your game demands. Group and one-on-one training with Ben for high school, university, Canadian Football League (CFL) and professional-level athletes.</p>
<ul class="chips"><li>Acceleration</li><li>Top speed</li><li>Skill &amp; movement</li><li>Strength &amp; power</li></ul>
<a class="path-link" href="/football-performance/">Explore Football Performance <span class="arrow" aria-hidden="true">→</span></a>
</div>
</article>
</div>
</div>
</div>
</section>

<section class="section tone-3" id="coach" aria-labelledby="coach-title">
<hr class="laser" aria-hidden="true">
<div class="wrap coach">
<div class="coach-photo glass reveal">
<span class="hud tl" aria-hidden="true"></span><span class="hud br" aria-hidden="true"></span>
<div class="ben-video-wrap"><video class="ben-video" autoplay="autoplay" muted="muted" loop="loop" playsinline="playsinline" preload="metadata" poster="/media/meet-ben-poster.jpg" aria-label="Ben Pascoe coaching in the gym"><source src="/media/meet-ben.webm" type="video/webm"><source src="/media/meet-ben.mp4" type="video/mp4"></video></div>
</div>
<div class="coach-copy reveal r2">
<p class="kicker">Your coach</p>
<h2 id="coach-title" class="display">Meet Ben Pascoe</h2>
<p>Ben is an NSCA Certified Strength and Conditioning Specialist with more than ten years of strength coaching experience, including work with over 100 Ontario University Athletics varsity athletes. He coaches personal training clients and football athletes.</p>
<a class="btn btn-glass" href="/about/"><span>More About Ben</span><span class="arrow" aria-hidden="true">→</span></a>
</div>
</div>
</section>

<section class="section tone-2" id="approach" aria-labelledby="approach-title">
<hr class="laser" aria-hidden="true">
<div class="wrap">
<div class="section-head">
<div class="reveal">
<p class="kicker">The approach</p>
<h2 id="approach-title" class="display h2">From first message to first session</h2>
</div>
<p class="reveal r2">Start with a conversation about your goals, experience and the kind of coaching you need.</p>
</div>
<div class="steps">
<div class="step glass reveal">
<div class="step-num" aria-hidden="true">01</div>
<h3 class="display">Talk it through</h3>
<p>Send an inquiry, then talk with Ben about what you want to work toward and your availability.</p>
</div>
<div class="step glass reveal r2">
<div class="step-num" aria-hidden="true">02</div>
<h3 class="display">Choose your training</h3>
<p>Agree on the training option that fits: personal training in the gym, or group or one-on-one football training.</p>
</div>
<div class="step glass reveal r3">
<div class="step-num" aria-hidden="true">03</div>
<h3 class="display">Train and progress</h3>
<p>Train with Ben, check in on what is working and adjust as you progress.</p>
</div>
</div>
</div>
</section>

<section class="section tone-3 nutri-slim" id="nutrition" aria-labelledby="nutrition-title">
<hr class="laser" aria-hidden="true">
<div class="wrap nutri-row reveal">
<div>
<p class="kicker">Nutrition support</p>
<h2 id="nutrition-title" class="display h2">Train hard. Eat to match.</h2>
</div>
<p>Practical nutrition guidance is part of both training paths: everyday eating habits for personal training clients, and fueling and recovery for football athletes.</p>
</div>
</section>

<section class="section" id="faq" aria-labelledby="faq-title">
<hr class="laser" aria-hidden="true">
<div class="wrap">
<div class="section-head">
<div class="reveal">
<p class="kicker">Questions</p>
<h2 id="faq-title" class="display h2">Before you start</h2>
</div>
</div>
<div class="faq-list reveal">
<FaqList groups={faqs["home"]} />
</div>
<div class="faq-more reveal">
<a class="btn btn-glass" href="/personal-training/"><span>Personal Training Questions</span><span class="arrow" aria-hidden="true">→</span></a>
<a class="btn btn-glass" href="/football-performance/"><span>Football Performance Questions</span><span class="arrow" aria-hidden="true">→</span></a>
</div>
</div>
</section>

<section class="section tone-3" id="inquiry" aria-labelledby="inquiry-title">
<hr class="laser" aria-hidden="true">
<div class="wrap">
<div class="section-head">
<div class="reveal">
<p class="kicker">Start the conversation</p>
<h2 id="inquiry-title" class="display h2">Find your training path</h2>
</div>
<p class="reveal r2">Share what you want to work toward. If you're unsure which training option fits, choose Help Me Choose.</p>
</div>
<div class="inquiry-grid">
<InquiryForm preselect="" page="home" />
<aside class="contact-card glass reveal r2" aria-label="Contact details">
<h3 class="display">Get in touch</h3>
<div class="c-row"><span class="c-label">Email</span><span class="c-val ph-text">[CONTACT EMAIL]</span></div>
<div class="c-row"><span class="c-label">Phone</span><span class="c-val ph-text">[CONTACT PHONE]</span></div>
<div class="c-row"><span class="c-label">Personal training</span><span class="c-val">Anytime Fitness, Hamilton &amp; Ancaster</span></div>
<div class="c-row"><span class="c-label">Football training</span><span class="c-val">Turf and gym · <span class="ph-text">[VENUE NAME]</span></span></div>
</aside>
</div>
</div>
</section>
</Base>

---
// FAQ list. Answers are in the initial HTML (native details/summary), and the
// same data feeds the FAQPage structured data in src/data/schema.ts.
interface Props {
  groups: { category: string; items: { id: string; q: string; a: string }[] }[];
}
const { groups } = Astro.props;
---
{groups.map((g) => (
  <>
    {g.category && <h3 class="faq-cat">{g.category}</h3>}
    {g.items.map((f) => (
      <details class="faq glass" id={f.id}>
        <summary>{f.q} <span class="faq-icon" aria-hidden="true">+</span></summary>
        <p set:html={f.a} />
      </details>
    ))}
  </>
))}

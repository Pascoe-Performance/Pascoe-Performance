---
import Logo from './Logo.astro';
import { pages, type PageKey } from '../data/site';

interface Props {
  current: PageKey;
  contactHref: string;
}
const { current, contactHref } = Astro.props;
const links: PageKey[] = ['personal-training', 'football-performance', 'about'];
const year = new Date().getFullYear();
---
<footer class="footer">
  <hr class="laser" aria-hidden="true" />
  <div class="wrap">
    <div class="footer-grid">
      <div>
        <a class="brand" href="/" aria-label="Pascoe Performance home">
          <Logo />
          <span class="brand-name">Pascoe Performance</span>
        </a>
        <p>Personal training in Hamilton &amp; Ancaster and football performance training across the Greater Toronto &amp; Hamilton Area, Ontario.</p>
      </div>
      <nav aria-label="Footer">
        {links.map((k) => (
          <a class="navlink" href={pages[k].path} aria-current={current === k ? 'page' : undefined}><span class="nl">{pages[k].nav}</span></a>
        ))}
        <a class="navlink" href={contactHref}><span class="nl">Contact</span></a>
        <a class="navlink" href="/privacy/" aria-current={current === 'privacy' ? 'page' : undefined}><span class="nl">Privacy</span></a>
      </nav>
    </div>
    <div class="footer-base"><span>© {year} Pascoe Performance</span><span>Coach Ben Pascoe</span></div>
  </div>
</footer>

# Public URL of the live site (no trailing slash), e.g. https://pascoeperformance.ca
SITE_URL=

# Leave as "true" (or unset) while the site is a private preview:
# pages are marked noindex and robots.txt blocks search engines.
# Set to "false" at launch.
PUBLIC_PREVIEW=true

# Only needed when NOT hosting on Netlify (e.g. Vercel).
# A form service endpoint such as https://formspree.io/f/xxxxxxx
PUBLIC_FORM_ENDPOINT=

# Public URL of the live site (no trailing slash), e.g. https://pascoeperformance.ca
SITE_URL=

# Leave as "true" (or unset) while the site is a private preview:
# pages are marked noindex and robots.txt blocks search engines.
# Set to "false" at launch.
PUBLIC_PREVIEW=true

# Form email (Cloudflare Pages Function, set these in Cloudflare, not here)
# RESEND_API_KEY=   (secret)
# INQUIRY_TO=ben@example.com
# INQUIRY_FROM="Pascoe Performance <inquiries@pascoeperformance.ca>"

# Optional: send the form to another service instead of /api/inquiry
PUBLIC_FORM_ENDPOINT=
